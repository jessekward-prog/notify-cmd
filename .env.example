# Postgres — Coolify's Postgres needs ?sslmode=disable
DATABASE_URL=postgres://user:pass@host:5432/notifycmd?sslmode=disable

# Shared secret in the MacroDroid webhook URL: /api/webhook/<WEBHOOK_TOKEN>
WEBHOOK_TOKEN=

# Shared secret for GET /api/notifications/recent, read by reverb's
# get_recent_notifications tool. Must match NOTIFY_CMD_SERVICE_TOKEN in reverb's env.
SERVICE_TOKEN=
